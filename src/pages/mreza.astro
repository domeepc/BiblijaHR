---
import Base from '../layouts/Base.astro';
import Network from '../components/Network';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base title="Mreža unakrsnih referenci – Šarićeva Biblija" page="net">
  <main class="wrap net">
    <Network client:only="preact" base={base}>
      <div slot="fallback" class="loading">Učitavam mrežu unakrsnih referenci…</div>
    </Network>
    <noscript><p class="loading">Mreža treba JavaScript. Čitanje radi i bez njega.</p></noscript>
  </main>
</Base>
