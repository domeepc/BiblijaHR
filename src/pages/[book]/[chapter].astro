---
import Base from '../../layouts/Base.astro';
import { getBible, linksOf, snippet } from '../../lib/bible';
import { chapterHref, chapterOf, refLabel, verseOf } from '../../lib/shared';

export function getStaticPaths() {
  const { books } = getBible();
  return books.flatMap((book, b) => book.chs.map((ch) => ({ params: { book: book.slug, chapter: String(ch) }, props: { b, ch } })));
}

const { b, ch } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const B = getBible();
const book = B.books[b];
const label = (i: number, span = 0) => refLabel(B.books, B.vb, B.k, i, span);
const hrefOf = (i: number) => chapterHref(base, B.books[B.vb[i]], chapterOf(B.k, i), verseOf(B.k, i));
const testament = (i: number) => (B.books[B.vb[i]].t ? 'nt' : 'ot');

const MENU_MAX = 24;
const verses = [];
for (let i = book.s; i < book.s + book.c; i++) {
  if (chapterOf(B.k, i) !== ch) continue;
  const links = linksOf(i);
  const nTw = Math.min(5, Math.max(1, Math.ceil(Math.log2(links.length + 1))));
  verses.push({
    i, num: verseOf(B.k, i), text: B.v[i] || '—', count: links.length,
    twigs: links.slice(0, nTw).map((l, j) => {
      const y = 22 + (j - (nTw - 1) / 2) * 7.5;
      return { y, cls: 'twig-' + testament(l.i), d: `M64 22 C 84 22, 88 ${y}, 108 ${y}` };
    }),
    menu: links.slice(0, MENU_MAX).map((l) => ({
      href: hrefOf(l.i), ref: label(l.i, l.span), votes: l.v, cls: testament(l.i), text: snippet(B.v[l.i] || '—'),
    })),
  });
}

// previous / next chapter, across book boundaries
const first = verses[0].i, last = verses[verses.length - 1].i;
const prev = first > 0 ? first - 1 : -1;
const next = last + 1 < B.k.length ? last + 1 : -1;
const chapLink = (i: number) => (i < 0 ? null : { href: chapterHref(base, B.books[B.vb[i]], chapterOf(B.k, i)), label: `${B.books[B.vb[i]].a} ${chapterOf(B.k, i)}` });
const prevC = chapLink(prev), nextC = chapLink(next);
const netHref = (v: number) => `${base}mreza/?v=${book.slug}.${ch}.${v}`;
---
<Base title={`${book.n} ${ch} – Šarićeva Biblija`} description={`${book.n}, ${ch}. glava, prijevod Ivana Šarića, s unakrsnim referencama.`} page="read" at={{ b, ch }}>
  <main class="reader" data-slug={book.slug} data-ch={ch}>
    <div class="chapter-head">
      <p class="overline">{book.n}</p>
      <h1>Glava {ch}</h1>
      <svg class="ornament" width="140" height="16" viewBox="0 0 140 16" aria-hidden="true">
        <path d="M4 8h54M82 8h54" stroke-width="1" /><path d="M70 2l6 6-6 6-6-6z" stroke-width="1.2" />
      </svg>
    </div>

    <div class="verses" lang="hr">
      {verses.map((v) => (
        <div class="verse" id={`v${v.num}`}>
          <p><a class="vnum" href={`#v${v.num}`} aria-label={`Redak ${v.num}`}>{v.num}</a><span class="vtext">{v.text}</span>{v.count > 0 && <span class="vend" aria-hidden="true"></span>}</p>
          {v.count > 0 && <svg class="lead" aria-hidden="true"><path /><circle r="2.4" /></svg>}
          <div>
            {v.count > 0 && (
              <button class="branch" type="button" popovertarget={`m${v.num}`} aria-label={`Grana retka ${v.num}: ${v.count} referenci`}>
                <svg viewBox="0 0 176 44" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
                  <path class="stem" d="M0 22 C 24 22, 36 22, 64 22" />
                  {v.twigs.map((t) => (<><path class="stem" d={t.d} /><circle class={t.cls} cx="112" cy={t.y} r="3.6" /></>))}
                  <rect class="pill" x="124" y="12" width="44" height="20" rx="10" />
                  <text class="pill-text" x="146" y="22.5">{v.count} ▾</text>
                </svg>
              </button>
            )}
          </div>
          {v.count > 0 && (
            <div class="refmenu" id={`m${v.num}`} popover aria-label={`Reference za ${book.a} ${ch},${v.num}`}>
              <div class="refmenu-head">
                <span><strong>{book.a} {ch},{v.num}</strong> · {v.count} referenci</span>
                <button class="refmenu-close" type="button" popovertarget={`m${v.num}`} popovertargetaction="hide" aria-label="Zatvori">
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
              </div>
              <ul>
                {v.menu.map((m) => (
                  <li><a href={m.href}>
                    <span class={`dot ${m.cls}`}></span>
                    <span><span class="row"><strong>{m.ref}</strong><span>{m.votes} glasova</span></span><span class="snip">{m.text}</span></span>
                  </a></li>
                ))}
              </ul>
              <a class="refmenu-net" href={netHref(v.num)}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><circle cx="4" cy="5" r="2" /><circle cx="20" cy="5" r="2" /><circle cx="4" cy="19" r="2" /><circle cx="20" cy="19" r="2" /><path d="M6 6l4 4M18 6l-4 4M6 18l4-4M18 18l-4-4" /></svg>
                Prikaži u mreži
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

    <nav class="chapter-nav" aria-label="Glave">
      {prevC ? <a class="pill-link" href={prevC.href} rel="prev"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>{prevC.label}</a> : <span></span>}
      <span>{book.n} {ch} · {verses.length} redaka</span>
      {nextC ? <a class="pill-link" href={nextC.href} rel="next">{nextC.label}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a> : <span></span>}
    </nav>
  </main>
</Base>

<script>
  // Place each reference menu under the branch that opened it (popovers live in the top layer).
  function place(menu: HTMLElement) {
    const btn = document.querySelector<HTMLElement>(`.branch[popovertarget="${menu.id}"]`);
    if (!btn) return;
    const r = btn.getBoundingClientRect();
    const w = menu.offsetWidth, h = menu.offsetHeight;
    const left = Math.min(Math.max(r.right - w, 12), window.innerWidth - w - 12);
    const below = r.bottom + 6;
    const top = below + h > window.innerHeight - 12 && r.top - h - 6 > 12 ? r.top - h - 6 : below;
    menu.style.left = `${left}px`;
    menu.style.top = `${Math.max(top, 12)}px`;
  }
  document.querySelectorAll<HTMLElement>('.refmenu').forEach((menu) => {
    menu.addEventListener('toggle', (e) => { if ((e as ToggleEvent).newState === 'open') place(menu); });
    // a reference in the same chapter only changes the hash: close the menu ourselves
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
  });
  const reposition = () => document.querySelectorAll<HTMLElement>('.refmenu:popover-open').forEach(place);
  window.addEventListener('scroll', reposition, { passive: true });
  window.addEventListener('resize', reposition);

  // Grow each branch out of the end of its verse: put the branch on the verse's last line
  // and draw the lead from the last word across to the margin.
  function layoutBranches() {
    const jobs = [...document.querySelectorAll<HTMLElement>('.verse')].flatMap((v) => {
      const end = v.querySelector<HTMLElement>('.vend'), br = v.querySelector<HTMLElement>('.branch');
      if (!end || !br) return [];
      const vr = v.getBoundingClientRect(), er = end.getBoundingClientRect();
      return [{ v, br, x: er.left - vr.left + 6, y: er.top + er.height / 2 - vr.top, bx: br.parentElement!.getBoundingClientRect().left - vr.left }];
    });
    for (const { v, br, x, y, bx } of jobs) {   // all reads above, all writes here
      br.style.marginTop = `${Math.round(y - 22)}px`;
      const path = v.querySelector('.lead path')!, dot = v.querySelector('.lead circle')!;
      path.setAttribute('d', x < bx - 2 ? `M${x} ${y} H${bx}` : '');
      dot.setAttribute('cx', String(Math.min(x, bx)));
      dot.setAttribute('cy', String(y));
    }
  }
  const versesEl = document.querySelector('.verses');
  if (versesEl) {
    new ResizeObserver(() => layoutBranches()).observe(versesEl);
    document.fonts?.ready.then(layoutBranches);
  }

  // remember where we are reading
  const main = document.querySelector<HTMLElement>('.reader')!;
  const remember = () => {
    const v = location.hash.match(/^#v(\d+)$/)?.[1] ?? '0';
    try { localStorage.setItem('biblija:last', `${main.dataset.slug}.${main.dataset.ch}.${v}`); } catch {}
  };
  remember();
  window.addEventListener('hashchange', remember);
</script>
